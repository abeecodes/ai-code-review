# Which LLM to use: ollama (free, local) | groq (free tier) | openai | anthropic
LLM_PROVIDER=ollama

# Set the model for the provider you use. Do NOT use LLM_MODEL while switching providers: it applies to all of
# them, so a leftover Ollama name sent to Groq causes "model not found". Leave a line empty for the default.
OLLAMA_MODEL=qwen2.5-coder:7b
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_MODEL=
ANTHROPIC_MODEL=
LLM_MODEL=

# API keys (only the provider you use). Never commit the real .env file.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

LLM_CACHE=true
USE_MCP=true
MCP_TIMEOUT=30

# subprocess = NOT a security boundary (runs generated tests as your user). docker = isolated (recommended).
SANDBOX_MODE=subprocess
SANDBOX_TIMEOUT=30
PER_TEST_TIMEOUT=5
SANDBOX_IMAGE=code-review-sandbox
# only if `node` is not on your PATH
NODE_BINARY=node
